@@ -1,5 +1,6 @@
 from __future__ import annotations
 
+import os
 import threading
 import time
 from concurrent.futures import Future, ThreadPoolExecutor
@@ -21,6 +22,82 @@ _CPU_EXECUTOR = ThreadPoolExecutor(
 )
 
 
+def _retrieval_worker_count() -> int:
+    try:
+        value = int(os.getenv("MCP_CONTEXT_RETRIEVAL_WORKERS", "4"))
+    except ValueError:
+        value = 4
+    return max(1, min(8, value))
+
+
+class BoundedRetrievalQueue:
+    """Process-lifetime retrieval executor with bounded admission."""
+
+    def __init__(self) -> None:
+        self.workers = _retrieval_worker_count()
+        self.capacity = self.workers * 2
+        self._executor = ThreadPoolExecutor(
+            max_workers=self.workers, thread_name_prefix="mcp-retrieval"
+        )
+        self._slots = threading.BoundedSemaphore(self.capacity)
+        self._lock = threading.Lock()
+        self._queued = 0
+        self._active = 0
+        self._submitted = 0
+        self._completed = 0
+        self._failed = 0
+        self._wait_ms = 0.0
+        self._work_ms = 0.0
+        self._parallel_wall_ms = 0.0
+
+    def submit(self, work: Callable[[], Any]) -> Future[Any]:
+        waited = time.perf_counter()
+        self._slots.acquire()
+        wait_ms = (time.perf_counter() - waited) * 1000
+        with self._lock:
+            self._queued += 1
+            self._submitted += 1
+            self._wait_ms += wait_ms
+
+        def run() -> Any:
+            started = time.perf_counter()
+            with self._lock:
+                self._queued -= 1
+                self._active += 1
+            try:
+                return work()
+            except Exception:
+                with self._lock:
+                    self._failed += 1
+                raise
+            finally:
+                with self._lock:
+                    self._active -= 1
+                    self._completed += 1
+                    self._work_ms += (time.perf_counter() - started) * 1000
+                self._slots.release()
+
+        return self._executor.submit(run)
+
+    def metrics(self) -> dict[str, Any]:
+        with self._lock:
+            return {
+                "configured_workers": self.workers,
+                "active_workers": self._active,
+                "queue_depth": self._queued,
+                "submitted_tasks": self._submitted,
+                "completed_tasks": self._completed,
+                "failed_tasks": self._failed,
+                "queue_wait_ms": round(self._wait_ms, 3),
+                "parallel_wall_ms": round(self._parallel_wall_ms, 3),
+                "aggregate_worker_work_ms": round(self._work_ms, 3),
+            }
+
+    def record_parallel_wall(self, elapsed_ms: float) -> None:
+        with self._lock:
+            self._parallel_wall_ms += max(0.0, float(elapsed_ms))
+
+
 def service_executor() -> ThreadPoolExecutor:
     return _SERVICE_EXECUTOR
 
