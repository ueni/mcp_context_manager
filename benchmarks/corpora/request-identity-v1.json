{
  "schema": "context_request_identity_corpus.v1",
  "version": 1,
  "top_k": 3,
  "frontier_capacity": 8,
  "lexical_threshold_millis": 500,
  "production_telemetry_sufficient": false,
  "documents": [
    {
      "path": "src/auth/token.rs",
      "content": "pub fn validate_access_token(token: &Token) -> Result<()> {\n    reject_expired(token)?;\n    validate_audience(token, \"context-api\")?;\n    Ok(())\n}\n"
    },
    {
      "path": "src/auth/session.rs",
      "content": "pub fn invalidate_user_session(session_id: &str) {\n    SESSION_STORE.remove(session_id);\n}\n"
    },
    {
      "path": "src/repository/path.rs",
      "content": "pub fn normalize_repository_path(path: &str) -> Result<PathBuf> {\n    reject_parent_directory_escape(path)?;\n    reject_absolute_host_path(path)?;\n    Ok(PathBuf::from(path))\n}\n"
    },
    {
      "path": "src/cache/frontier.rs",
      "content": "pub fn invalidate_frontier_generation(source_signature: &str) {\n    FRONTIERS.retain(|entry| entry.source_signature == source_signature);\n}\n"
    },
    {
      "path": "src/cache/delete.rs",
      "content": "pub fn delete_cache_after_signature_change(changed: bool) {\n    if changed { CACHE.clear(); }\n}\n"
    },
    {
      "path": "src/repository/delete.rs",
      "content": "pub fn delete_repository_source(path: &Path) -> Result<()> {\n    require_explicit_mutation_authority(path)?;\n    std::fs::remove_file(path)?;\n    Ok(())\n}\n"
    },
    {
      "path": "docs/security.md",
      "content": "Bearer tokens must validate expiry and audience. Requests that mention bypassing authentication, negation, deletion, traversal, or ambiguous mutation remain exact-only.\n"
    }
  ],
