{
  "version": "2.0.0",
  "options": {
    "shell": {
      "executable": "bash",
      "args": [
        "-lc"
      ]
    }
  },
  "tasks": [
    {
      "label": "build: docker image",
      "type": "shell",
      "command": "cmake --preset local-sudo-docker && cmake --build --preset docker-image-sudo-docker",
      "group": {
        "kind": "build"
      },
      "problemMatcher": []
    },
    {
      "label": "build: standalone executable",
      "type": "shell",
      "command": "cmake --preset local-sudo-docker && cmake --build --preset standalone-sudo-docker",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build: docker image tar.gz",
      "type": "shell",
      "command": "cmake --preset local-sudo-docker && cmake --build --preset docker-image-archive-sudo-docker",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build: local release artifacts",
      "type": "shell",
      "command": "cmake --preset local-sudo-docker && cmake --build --preset local-release-artifacts-sudo-docker",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "mcp: restart & rebuild",
      "type": "shell",
      "command": "sudo env \"PATH=$PATH\" \"DOCKER_CONFIG=$HOME/.docker\" \"HOME=$HOME\" MCP_CONTEXT_HOST_ROOT=/home/user/source docker compose up -d --build",
      "dependsOn": [
        "build: standalone executable"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "test: full",
      "type": "shell",
      "command": "python3 -m pytest && python3 -m ruff check .",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
